# Controls what `gcloud builds submit` / `gcloud run deploy --source` UPLOADS.
# We deliberately do NOT fall back to .gitignore (which ignores app/storage & venv),
# because the prebuilt index under app/storage/ MUST be uploaded and baked in.

venv/
**/__pycache__/
*.pyc
.git/
.gitignore

# secrets / local-only
.env
keys/

# temp / logs
temp.docx
temp_*.docx
*.log
compilation.log

# NOTE: app/storage/ is intentionally NOT ignored — it is the baked index.
